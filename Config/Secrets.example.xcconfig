// 1. Copy this file to Config/Secrets.xcconfig (same folder).
// 2. Fill in your values. Secrets.xcconfig is git-ignored, so your keys stay private.

// Required. Google Cloud Console → enable "Maps SDK for iOS" and "Places API (New)" → create an API key.
GOOGLE_MAPS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY

// Optional. https://besttime.app → API keys → private key (starts with pri_).
BESTTIME_API_KEY_PRIVATE = YOUR_BESTTIME_PRIVATE_KEY

// Optional. Your Apple Developer Team ID (Xcode → Signing & Capabilities).
// The bundle ID is already set to com.istalin.CrowdFinder in CrowdFinder.xcconfig.
// DEVELOPMENT_TEAM = ABCDE12345
